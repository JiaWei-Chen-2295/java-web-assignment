<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<div class="slider" id="slider">
  <div class="slides" id="slides">
    <div class="slide" style="background-image:url('https://images.unsplash.com/photo-1523050854058-8df90110c8f1?w=1200&q=80')">
      <div class="slide-text">Cherry Blossom Campus</div>
    </div>
    <div class="slide" style="background-image:url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?w=1200&q=80')">
      <div class="slide-text">Classic University Architecture</div>
    </div>
    <div class="slide" style="background-image:url('https://images.unsplash.com/photo-1562774053-701939374585?w=1200&q=80')">
      <div class="slide-text">Green Campus Paths</div>
    </div>
    <div class="slide" style="background-image:url('https://images.unsplash.com/photo-1592280771190-3e2e4d571952?w=1200&q=80')">
      <div class="slide-text">Library & Study Spaces</div>
    </div>
  </div>
  <div class="slider-dots">
    <div class="dot active" onclick="goSlide(0)"></div>
    <div class="dot" onclick="goSlide(1)"></div>
    <div class="dot" onclick="goSlide(2)"></div>
    <div class="dot" onclick="goSlide(3)"></div>
  </div>
</div>
<script>
  let current = 0;
  const slides = document.getElementById('slides');
  const dots = document.querySelectorAll('.dot');
  function goSlide(n) {
    current = n;
    slides.style.transform = 'translateX(-' + n * 100 + '%)';
    dots.forEach((d, i) => d.classList.toggle('active', i === n));
  }
  setInterval(() => goSlide((current + 1) % 4), 4000);
</script>
